# Darklands Accessibility user configuration.
# The ${NAME:-value} form preserves a value already exported by the caller.

DARKLANDS_GAME_DIR="${DARKLANDS_GAME_DIR:-$HOME/dosGames/darklands}"
DARKLANDS_GAME_EXE="${DARKLANDS_GAME_EXE:-$DARKLANDS_GAME_DIR/darkland.exe}"

DARKTEXT_DATA_DIR="${DARKTEXT_DATA_DIR:-$HOME/.local/share/darklands-accessibility/data}"
DARKTEXT_VOICE_DIR="${DARKTEXT_VOICE_DIR:-$HOME/.local/share/piper-tts/voices}"

DARKLANDS_VOICE_DIR="${DARKLANDS_VOICE_DIR:-$DARKTEXT_VOICE_DIR}"
DARKLANDS_COORDS_CONFIG="${DARKLANDS_COORDS_CONFIG:-$HOME/.config/darklands-coords.json}"

# If Piper is not on PATH, uncomment and adjust these:
# DARKTEXT_PIPER_BIN="$HOME/.local/bin/piper"
# DARKLANDS_PIPER_BIN="$DARKTEXT_PIPER_BIN"

DOSBOX_WEBSERVER_BIND="${DOSBOX_WEBSERVER_BIND:-127.0.0.1}"
DOSBOX_WEBSERVER_PORT="${DOSBOX_WEBSERVER_PORT:-8086}"
DOSBOX_API_URL="${DOSBOX_API_URL:-http://$DOSBOX_WEBSERVER_BIND:$DOSBOX_WEBSERVER_PORT}"
