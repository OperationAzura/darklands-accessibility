# Darklands Accessibility configuration.
#
# The installer copies this to ./local/config/darklands.env by default.
# The ${NAME:-value} form means an exported environment variable can override
# any setting without editing the file.

# ---------------------------------------------------------------------------
# Installation layout
# ---------------------------------------------------------------------------
# DARKLANDS_PROJECT_DIR is supplied by the installer/launcher when possible.
DARKLANDS_INSTALL_ROOT="${DARKLANDS_INSTALL_ROOT:-${DARKLANDS_PROJECT_DIR:-$PWD}/local}"
DARKLANDS_INSTALL_USER_COMMANDS="${DARKLANDS_INSTALL_USER_COMMANDS:-0}"
DARKLANDS_USER_BIN_DIR="${DARKLANDS_USER_BIN_DIR:-$HOME/.local/bin}"

# ---------------------------------------------------------------------------
# Component repositories and branches
# ---------------------------------------------------------------------------
DARKLANDS_DOSBOX_REPO_URL="${DARKLANDS_DOSBOX_REPO_URL:-https://github.com/OperationAzura/dosboxStagingAccess.git}"
DARKLANDS_DOSBOX_BRANCH="${DARKLANDS_DOSBOX_BRANCH:-darklands-accessibility}"

DARKLANDS_DARKTEXT_REPO_URL="${DARKLANDS_DARKTEXT_REPO_URL:-https://github.com/OperationAzura/darktext.git}"
DARKLANDS_DARKTEXT_BRANCH="${DARKLANDS_DARKTEXT_BRANCH:-main}"

DARKLANDS_COORDS_REPO_URL="${DARKLANDS_COORDS_REPO_URL:-https://github.com/OperationAzura/darklands-coords.git}"
DARKLANDS_COORDS_BRANCH="${DARKLANDS_COORDS_BRANCH:-main}"

# ---------------------------------------------------------------------------
# Game location. Darklands itself is never copied or modified by the installer.
# ---------------------------------------------------------------------------
DARKLANDS_GAME_DIR="${DARKLANDS_GAME_DIR:-$HOME/dosGames/darklands}"
DARKLANDS_GAME_EXE="${DARKLANDS_GAME_EXE:-$DARKLANDS_GAME_DIR/darkland.exe}"

# ---------------------------------------------------------------------------
# DarkText / Piper
# ---------------------------------------------------------------------------
# By default Piper and its voice live entirely inside the project-local tree.
DARKTEXT_DATA_DIR="${DARKTEXT_DATA_DIR:-$DARKLANDS_INSTALL_ROOT/data}"
DARKTEXT_VOICE_DIR="${DARKTEXT_VOICE_DIR:-$DARKLANDS_INSTALL_ROOT/voices}"
DARKTEXT_PIPER_BIN="${DARKTEXT_PIPER_BIN:-$DARKLANDS_INSTALL_ROOT/bin/piper}"

DARKLANDS_PIPER_PACKAGE="${DARKLANDS_PIPER_PACKAGE:-piper-tts==1.4.2}"
DARKLANDS_PIPER_VOICE="${DARKLANDS_PIPER_VOICE:-en_US-amy-medium}"
DARKLANDS_VOICE_DIR="${DARKLANDS_VOICE_DIR:-$DARKTEXT_VOICE_DIR}"
DARKLANDS_PIPER_BIN="${DARKLANDS_PIPER_BIN:-$DARKTEXT_PIPER_BIN}"
DARKLANDS_COORDS_CONFIG="${DARKLANDS_COORDS_CONFIG:-$DARKLANDS_INSTALL_ROOT/config/darklands-coords.json}"

# ---------------------------------------------------------------------------
# DOSBox accessibility API
# ---------------------------------------------------------------------------
DOSBOX_WEBSERVER_BIND="${DOSBOX_WEBSERVER_BIND:-127.0.0.1}"
DOSBOX_WEBSERVER_PORT="${DOSBOX_WEBSERVER_PORT:-8086}"
DOSBOX_API_URL="${DOSBOX_API_URL:-http://$DOSBOX_WEBSERVER_BIND:$DOSBOX_WEBSERVER_PORT}"
